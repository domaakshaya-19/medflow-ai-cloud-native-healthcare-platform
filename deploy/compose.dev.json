        "FRONTEND_URL": "http://localhost:15173",
        "SPRING_DATASOURCE_HIKARI_MAXIMUM_POOL_SIZE": "4",
        "SPRING_DATASOURCE_HIKARI_MINIMUM_IDLE": "1",
        "AUTH_DB_URL": "jdbc:postgresql://auth-db:5432/medflow_auth",
        "AUTH_DB_USER": "medflow_auth",
        "AUTH_SERVICE_PORT": "8081",
        "ADMIN_BOOTSTRAP_EMAIL": "admin@example.test"
      },
      "secrets": [
        {
          "source": "auth-app",
          "target": "AUTH_DB_PASSWORD"
        },
        {
          "source": "jwt",
          "target": "JWT_SECRET"
        },
        {
          "source": "bootstrap",
          "target": "ADMIN_BOOTSTRAP_PASSWORD"
        }
      ],
      "depends_on": {
        "discovery-server": {
          "condition": "service_started"
        },
        "auth-db": {
          "condition": "service_healthy"
        }
      },
      "deploy": {
        "resources": {
          "limits": {
            "memory": "512M"
          }
        }
      }
    },
