{
  "name": "medflow-demo-isolated",
  "services": {
    "auth-db": {
      "image": "postgres:16-alpine",
      "environment": {
        "POSTGRES_USER": "postgres",
        "POSTGRES_DB": "medflow_auth",
        "POSTGRES_PASSWORD_FILE": "/run/secrets/admin-password",
        "APP_DB_USER": "medflow_auth",
        "APP_DB_PASSWORD_FILE": "/run/secrets/app-password"
      },
      "secrets": [
        {
          "source": "auth-admin",
          "target": "admin-password"
        },
        {
          "source": "auth-app",
          "target": "app-password"
        }
      ],
      "volumes": [
        "auth-data:/var/lib/postgresql/data",
        "./init-app-role.sh:/docker-entrypoint-initdb.d/01-app-role.sh:ro"
      ],
      "networks": [
        "medflow"
      ],
      "healthcheck": {
        "test": [
          "CMD-SHELL",
          "pg_isready -U postgres -d medflow_auth"
        ],
        "interval": "5s",
        "timeout": "3s",
        "retries": 20
      }
    },
